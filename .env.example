# =============================================================================
# Drosophila-NeuroAtlas — Environment Configuration Template
# =============================================================================
#
# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and must NEVER be committed.
#
# cp .env.example .env
#
# =============================================================================

# -----------------------------------------------------------------------------
# Connectome Provider
# -----------------------------------------------------------------------------
# Select the data source:
#   "synthetic" (default) — no network, no credentials required
#   "real"                — queries the official neuPrint API
#
CONNECTOME_PROVIDER=synthetic

# -----------------------------------------------------------------------------
# neuPrint API Credentials  (required only when CONNECTOME_PROVIDER=real)
# -----------------------------------------------------------------------------
#
# NEUPRINT_TOKEN
#   Your personal neuPrint Bearer token (JWT).
#   Obtain it from: https://neuprint.janelia.org → Account page (after
#   signing in with Google).
#   NEVER share or commit this token.
#
NEUPRINT_TOKEN=your_neuprint_token_here

# NEUPRINT_BASE_URL
#   Official Janelia neuPrint server (do not change unless using a mirror).
#
NEUPRINT_BASE_URL=https://neuprint.janelia.org

# NEUPRINT_DATASET
#   Dataset identifier for the real Drosophila male CNS connectome.
#   Current official version: male-cns:v1.0
#   License: CC-BY 4.0
#   Source: https://neuprint.janelia.org
#
NEUPRINT_DATASET=male-cns:v1.0
